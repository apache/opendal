(rule
 (targets libopendal_core.a dllopendal_core.so opendal_core_link_flags.sexp)
 (deps
  ../Cargo.toml
  (glob_files *.rs))
 (action
  (progn
   (run sh -c
     "cd %{project_root}/../.. && cargo rustc --release -- --print=native-static-libs=target/release/opendal_core_link_flags")
   (run cp %{project_root}/../../target/release/libopendal_ocaml.a
     libopendal_core.a)
   (run sh -ec
     "if [ '%{ocaml-config:system}' = macosx ]; then ext=dylib; else ext=so; fi\n     cp %{project_root}/../../target/release/libopendal_ocaml.$ext dllopendal_core.so")
   (with-stdout-to
    opendal_core_link_flags.sexp
    (progn
     (echo "(")
     (run cat %{project_root}/../../target/release/opendal_core_link_flags)
     (echo ")"))))))

(library
 (name opendal_core)
 (public_name opendal.opendal_core)
 (foreign_archives opendal_core)
 ; Static linking also needs Rust's system libraries and platform frameworks.
 (c_library_flags
  (:include opendal_core_link_flags.sexp)))
