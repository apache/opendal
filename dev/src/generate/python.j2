use crate::*;

#[pyclass(
    eq,
    eq_int,
    dict,
    hash,
    frozen,
    module = "opendal.services",
    from_py_object
)]
#[pyo3(rename_all = "PascalCase")]
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum Scheme {
{%- for name in srvs %}
    #[cfg(feature = "{{service_to_feature(name)}}")]
    {{ service_to_pascal(name) }},
{%- endfor %}
}

#[pymethods]
impl Scheme {
    #[getter]
    pub fn name(&self) -> String {
        format!("{:?}", self)
    }

    #[getter]
    pub fn value(&self) -> &'static str {
        (*self).into()
    }
}

macro_rules! impl_enum_to_str {
    ($src:ty { $(
        $(#[$cfg:meta])?
        $variant:ident => $value:literal
    ),* $(,)? }) => {
        impl From<$src> for &'static str {
            fn from(value: $src) -> Self {
                match value {
                    $(
                        $(#[$cfg])?
                        <$src>::$variant => $value,
                    )*
                }
            }
        }

        impl From<$src> for String {
            fn from(value: $src) -> Self {
                let v: &'static str = value.into();
                v.to_string()
            }
        }
    };
}

impl_enum_to_str!(
    Scheme {
{%- for name in srvs %}
        #[cfg(feature = "{{ service_to_feature(name) }}")]
        {{ service_to_pascal(name) }} => "{{ snake_to_kebab_case(name) }}",
{%- endfor %}
    }
);

/// Return the config fields of `scheme` that core reads as a map from a JSON
/// object string. `from_config` converts a `dict` to that string only for
/// these fields.
pub(crate) fn map_config_fields(scheme: &str) -> &'static [&'static str] {
    match scheme {
{%- for item in map_fields %}
        #[cfg(feature = "{{ service_to_feature(item[0]) }}")]
        "{{ snake_to_kebab_case(item[0]) }}" => &[{% for field in item[1] %}"{{ field }}"{% if not loop.last %}, {% endif %}{% endfor %}],
{%- endfor %}
        _ => &[],
    }
}
