FROM alpine:3.22

# The pinned community image and dl.min.io download are unavailable.
# Keep the original fixture release using its archived official binary.
ADD --chmod=755 --checksum=sha256:dea08573980057d84c14d5c55926e10b91fb2993a99696ff136fb0bddaa7c98f \
    https://github.com/minio/minio/releases/download/RELEASE.2024-09-22T00-33-43Z/minio.linux-amd64.RELEASE.2024-09-22T00-33-43Z \
    /usr/bin/minio

ENTRYPOINT ["/usr/bin/minio"]
